{
  "name": "@light4/pi-session-manager",
  "version": "0.2.16",
  "packageManager": "pnpm@12.8.1",
  "description": "Discover, switch, and resume Pi sessions across terminal emulators.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "session-manager"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/light4/pi-session-manager.git"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.1",
    "@earendil-works/pi-coding-agent": "^1.0.1",
    "@earendil-works/pi-tui": "^1.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
